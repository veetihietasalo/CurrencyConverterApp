{
  "name": "currencyconverterapp",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist && node scripts/web-relative-paths.js dist",
    "deploy": "npm run export:web && gh-pages -d dist --dotfiles --nojekyll"
  },
  "dependencies": {
    "@expo/metro-runtime": "~2.2.16",
    "@react-native-picker/picker": "2.4.10",
    "expo": "~49.0.11",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.72.5",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "gh-pages": "^6.3.0"
  },
  "private": true
}
